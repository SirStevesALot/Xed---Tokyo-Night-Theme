<?xml version="1.0" encoding="UTF-8"?>
<style-scheme id="tokyo-night" _name="Tokyo Night" version="1.0">
  <author>Custom</author>
  <_description>Tokyo Night colour scheme</_description>

  <color name="bg"        value="#1a1b26"/>
  <color name="bg_dark"   value="#16161e"/>
  <color name="bg_hl"     value="#292e42"/>
  <color name="bg_sel"    value="#283457"/>
  <color name="fg"        value="#c0caf5"/>
  <color name="fg_dark"   value="#a9b1d6"/>
  <color name="comment"   value="#565f89"/>
  <color name="line_nr"   value="#3b4261"/>
  <color name="blue"      value="#7aa2f7"/>
  <color name="cyan"      value="#7dcfff"/>
  <color name="teal"      value="#1abc9c"/>
  <color name="green"     value="#9ece6a"/>
  <color name="magenta"   value="#bb9af7"/>
  <color name="orange"    value="#ff9e64"/>
  <color name="red"       value="#f7768e"/>
  <color name="yellow"    value="#e0af68"/>

  <!-- Editor -->
  <style name="text"                  foreground="fg" background="bg"/>
  <style name="selection"             foreground="fg" background="bg_sel"/>
  <style name="selection-unfocused"   background="bg_hl"/>
  <style name="cursor"                foreground="fg"/>
  <style name="current-line"          background="bg_hl"/>
  <style name="line-numbers"          foreground="line_nr" background="bg_dark"/>
  <style name="current-line-number"   foreground="blue" background="bg_dark"/>
  <style name="right-margin"          foreground="line_nr"/>
  <style name="draw-spaces"           foreground="line_nr"/>
  <style name="bracket-match"         foreground="orange" bold="true"/>
  <style name="bracket-mismatch"      foreground="red" underline="true"/>
  <style name="search-match"          background="#3d59a1"/>

  <!-- Generic syntax -->
  <style name="def:comment"           foreground="comment" italic="true"/>
  <style name="def:shebang"           foreground="comment" bold="true"/>
  <style name="def:doc-comment-element" foreground="comment" bold="true"/>
  <style name="def:constant"          foreground="orange"/>
  <style name="def:string"            foreground="green"/>
  <style name="def:special-char"      foreground="cyan"/>
  <style name="def:special-constant"  foreground="orange"/>
  <style name="def:number"            foreground="orange"/>
  <style name="def:floating-point"    foreground="orange"/>
  <style name="def:decimal"           foreground="orange"/>
  <style name="def:boolean"           foreground="orange"/>
  <style name="def:identifier"        foreground="blue"/>
  <style name="def:function"          foreground="blue"/>
  <style name="def:statement"         foreground="magenta"/>
  <style name="def:keyword"           foreground="magenta"/>
  <style name="def:operator"          foreground="cyan"/>
  <style name="def:preprocessor"      foreground="cyan"/>
  <style name="def:type"              foreground="teal"/>
  <style name="def:builtin"           foreground="red"/>
  <style name="def:variable"          foreground="fg"/>
  <style name="def:note"              foreground="yellow" bold="true"/>
  <style name="def:error"             foreground="red" bold="true"/>
  <style name="def:warning"           foreground="yellow"/>
  <style name="def:underlined"        foreground="blue" underline="true"/>
  <style name="def:link-destination"  foreground="cyan" underline="true"/>

  <!-- Markup / diffs -->
  <style name="diff:added-line"       foreground="green"/>
  <style name="diff:removed-line"     foreground="red"/>
  <style name="diff:changed-line"     foreground="yellow"/>
  <style name="diff:special-case"     foreground="cyan"/>
  <style name="diff:location"         foreground="magenta"/>
  <style name="diff:diff-file"        foreground="blue"/>
</style-scheme>
